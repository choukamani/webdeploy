# ── GCP ──────────────────────────────────────────────────────────────
PROJECT_ID=your-gcp-project
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Dedicated sites load balancer (provision once: python -m scripts.provision_sites_lb)
SITES_LB_PREFIX=webdeploy-sites
SITES_DEMO_HOST=demo.example.com
SITES_APPS_DOMAIN=example.com
SITES_DNS_ZONE=example-com

# Legacy load balancers — existing sites stay there; nothing new is added
DEMO_DOMAIN=example.com
DEMO_URL_MAP_NAME=legacy-demo-lb
PROD_URL_MAP_NAME=websites-urlmap-prod
PROD_GLOBAL_IP_NAME=websites-lb-ip-prod
PROD_HTTPS_PROXY_NAME=websites-https-proxy-prod

# Prod infrastructure toggles
PROD_AUTO_REGISTER_DOMAINS=false
PROD_AUTO_CREATE_DNS_ZONE=true
PROD_AUTO_CREATE_SSL_CERT=false

# Bucket
BUCKET_LOCATION=US
BUCKET_CORS_MAX_AGE=3600

# CDN
CDN_DEFAULT_TTL=3600
CDN_MAX_TTL=86400
CDN_CLIENT_TTL=3600
CDN_NEGATIVE_CACHING=true
CDN_NEGATIVE_CACHING_TTL=120

# ── AI Validation (providers tried in order, those without a key are skipped) ──
AI_PROVIDERS=gemini,openai_compatible,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
AI_ALERT_EMAILS=ops@example.com

# ── Email (Gmail API via service account) ────────────────────────────
GMAIL_DELEGATED_USER=deploy-bot@example.com
NOTIFICATION_FROM_EMAIL=webdeploy@example.com
NOTIFICATION_TO_EMAILS=team@example.com

# ── App ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
TEMP_DIR=./tmp
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/webdeploy.db
BUILD_TIMEOUT_SECONDS=300
PREVIEW_TIMEOUT_SECONDS=30
MAX_ZIP_SIZE_MB=500
